# =============================================================
#  Copy this file, rename it to .env and fill in the values for your environment.
# =============================================================

# ── MSSQL Database ─────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=IoTPlatform
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TRUST_SERVER_CERT=true

# CONNECTION_STRING is a composite connection string used by EF Core in appsettings.json or Program.cs
CONNECTION_STRING=Server=localhost,1433;Database=IoTPlatform;User Id=your_db_user;Password=your_db_password;TrustServerCertificate=true

# ── JWT (authentication) ─────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ISSUER=IoTPlatformApi
JWT_AUDIENCE=IoTPlatformClients
JWT_EXPIRES_MINUTES=60

# ── MQTT Broker ───────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# ── Environment ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

