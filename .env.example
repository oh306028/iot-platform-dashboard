# =============================================================
#  IoTPlatform — szablon zmiennych środowiskowych
#  Skopiuj ten plik jako .env i uzupełnij swoimi danymi.
#
# =============================================================

# ── Baza danych MSSQL ─────────────────────────────────────────
# DB_PASSWORD musi spełniać politykę MSSQL: min. 8 znaków,
# wielka litera, cyfra i znak specjalny.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=IoTPlatform
DB_USER=sa
DB_PASSWORD=YourStr0ngPassword!
DB_TRUST_SERVER_CERT=true

CONNECTION_STRING=Server=localhost,1433;Database=IoTPlatform;User Id=sa;Password=YourStr0ngPassword!;TrustServerCertificate=true

# ── JWT (uwierzytelnianie) ────────────────────────────────────
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ISSUER=IoTPlatformApi
JWT_AUDIENCE=IoTPlatformClients
JWT_EXPIRES_MINUTES=60

# ── MQTT Broker ───────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# ── Środowisko ────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

