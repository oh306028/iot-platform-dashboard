# ============================================================
#  .NET / Visual Studio / Rider  ─  .gitignore
# ============================================================

# Build outputs
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# NuGet packages (restored on build)
*.nupkg
*.snupkg
.nuget/
packages/
!**/packages/build/

# User-specific Visual Studio files
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
.vs/

# JetBrains Rider
.idea/
*.iml

# VS Code
.vscode/

# Roslyn / csc / build artefacts
*.pdb
*.ilk
*.iobj
*.ipdb
*.pgc
*.pgd
*.rsp

# ASP.NET / Secrets
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
**/Properties/launchSettings.json

# Entity Framework migrations (keep Migrations folder, ignore snapshots that get auto-regenerated)
# Uncomment the following line if you do NOT want to commit migrations:
# **/Migrations/

# Publish / deployment outputs
[Pp]ublish/
[Pp]ublish[Oo]utput/

# Temporary files
*.tmp
*.bak
*.swp
*~.nib
local.properties
.classpath
.settings/
.loadpath
.recommenders

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Docker
.dockerignore

# Terraform (if used for infrastructure-as-code)
**/.terraform/
*.tfstate
*.tfstate.backup

# Environment variables
.env
.env.*
!.env.example

